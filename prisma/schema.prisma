generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  email           String
  billingAddress  String?
  portalAccount   String? // account id at the customer's AP portal
  clearinghouseId String? // trading partner id for API submission
  createdAt       DateTime @default(now())

  rates          Rate[]
  comboDiscounts ComboDiscount[]
  orders         Order[]
  invoices       Invoice[]
  payments       Payment[]
}

model Product {
  id        String @id @default(cuid())
  sku       String @unique
  name      String
  unit      String // "seat", "GB", "1k calls", ...
  listPrice Float

  rates      Rate[]
  orderItems OrderItem[]
  combos     ComboDiscount[]
}

// One rate per customer+product. Edits update this row with the new price.
model Rate {
  id            String   @id @default(cuid())
  customerId    String
  productId     String
  unitPrice     Float
  // Volume tiers, e.g. [{"minQty": 100, "unitPrice": 4.5}, {"minQty": 500, "unitPrice": 3.75}]
  tiers         Json?
  effectiveDate DateTime @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([customerId, productId])
}

// If an order contains every product in the combo, those lines are discounted
// by percentOff. Scoped to one customer, or global when customerId is null.
model ComboDiscount {
  id         String  @id @default(cuid())
  customerId String?
  name       String
  percentOff Float

  customer Customer? @relation(fields: [customerId], references: [id])
  products Product[]
}

model Order {
  id         String   @id @default(cuid())
  reference  String? // sales order number, e.g. SO-0042
  customerId String
  orderDate  DateTime @default(now())
  status     String   @default("OPEN") // OPEN | INVOICED | CLOSED
  shipTo     String? // receiving party / delivery address
  notes      String?

  customer Customer       @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  invoice  Invoice?
  comments OrderComment[]
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  author    String
  body      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  rateId    String // points at the customer's current Rate for this product
  quantity  Float
  unitPrice Float // computed price, kept in sync with the rate

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  rate    Rate    @relation(fields: [rateId], references: [id])
}

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  customerId String
  orderId    String    @unique
  status     String    @default("DRAFT") // DRAFT | POSTED | SENT | PAID
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  total      Float     @default(0)
  amountPaid Float     @default(0)
  postedAt   DateTime?

  customer      Customer             @relation(fields: [customerId], references: [id])
  order         Order                @relation(fields: [orderId], references: [id])
  lines         InvoiceLine[]
  applications  PaymentApplication[]
  transmissions Transmission[]
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// A payment received from a customer. Recording it is separate from applying it;
// one payment can be applied across many invoices.
model Payment {
  id         String   @id @default(cuid())
  customerId String
  amount     Float
  receivedAt DateTime @default(now())
  reference  String?

  customer     Customer             @relation(fields: [customerId], references: [id])
  applications PaymentApplication[]
}

model PaymentApplication {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Float
  appliedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Transmission {
  id            String   @id @default(cuid())
  invoiceId     String
  method        String // EMAIL | PORTAL | API
  status        String // EMAIL: SENT; PORTAL: QUEUED|UPLOADING|DELIVERED; API: ACCEPTED
  externalJobId String?
  detail        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
