generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tenant ownership is introduced as a nullable expand-only boundary. Existing
// data remains addressable until the bounded tenant backfill and dual-write
// rollout are complete; new runtime authorization must scope every query by
// this value before it becomes required in a later contract migration.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  apiKeys                 TenantApiKey[]
  memberships             TenantMembership[]
  accountingPeriodControl TenantAccountingPeriodControl?
  customers               Customer[]
  products                Product[]
  comboDiscounts          ComboDiscount[]
  orders                  Order[]
  invoices                Invoice[]
  payments                Payment[]
  idempotencyRecords      IdempotencyRecord[]
}

enum TenantRole {
  ADMIN
  BILLING
  VIEWER
}

// SQLite stores Prisma enums as TEXT, so this is an additive generated-client
// typing improvement over the existing database representation. The database
// lifecycle guards remain the runtime authority for legacy and direct-SQL writes.
enum OrderStatus {
  OPEN
  INVOICED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  SENT
  PAID
  VOID
}

enum TransmissionMethod {
  EMAIL
  PORTAL
  API
}

enum TransmissionStatus {
  QUEUED
  UPLOADING
  DELIVERED
  SENT
  ACCEPTED
  FAILED
}

enum IdempotencyHttpMethod {
  POST
  PUT
  PATCH
  DELETE
}

enum IdempotencyRecordState {
  IN_PROGRESS
  COMPLETED
}

// The API key secret itself is never stored. keyHash is a one-way, versioned
// server-generated digest; keyPrefix is only an operator-facing identifier.
model TenantApiKey {
  id         String     @id @default(cuid())
  tenantId   String
  name       String
  role       TenantRole @default(BILLING)
  keyPrefix  String     @unique
  keyHash    String     @unique
  createdAt  DateTime   @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId, revokedAt])
}

// A user identity is an external subject, not an authentication secret. The
// eventual OIDC/session implementation owns subject verification.
model UserIdentity {
  id        String   @id @default(cuid())
  issuer    String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  memberships TenantMembership[]

  @@unique([issuer, subject])
}

model TenantMembership {
  id             String     @id @default(cuid())
  tenantId       String
  userIdentityId String
  role           TenantRole
  createdAt      DateTime   @default(now())
  revokedAt      DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userIdentity UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userIdentityId])
  @@index([userIdentityId, revokedAt])
}

// Kept separate from the legacy global AccountingPeriodControl until every
// financial row is tenant-scoped and reconciled.
model TenantAccountingPeriodControl {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  closedThroughDate String?
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model Customer {
  id              String   @id @default(cuid())
  tenantId        String?
  // Nullable during the expand/backfill rollout. Conditional-write endpoints
  // will atomically advance this monotonically increasing value once adopted.
  resourceVersion Int?
  name            String
  email           String
  billingAddress  String?
  portalAccount   String? // account id at the customer's AP portal
  clearinghouseId String? // trading partner id for API submission
  createdAt       DateTime @default(now())

  rates          Rate[]
  comboDiscounts ComboDiscount[]
  orders         Order[]
  invoices       Invoice[]
  payments       Payment[]
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Product {
  id               String   @id @default(cuid())
  tenantId         String?
  resourceVersion  Int?
  sku              String   @unique
  name             String
  unit             String // "seat", "GB", "1k calls", ...
  listPrice        Float // Legacy compatibility column; retire after the decimal cutover.
  listPriceDecimal Decimal? // DECIMAL(19,4) in the migration; nullable for expand/backfill/contract rollout.
  currencyCode     String? // Supported list-price currency (currently USD); nullable during rollout.

  rates      Rate[]
  orderItems OrderItem[]
  combos     ComboDiscount[]
  tenant     Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

// One rate per customer+product. Edits update this row with the new price.
model Rate {
  id               String   @id @default(cuid())
  resourceVersion  Int?
  customerId       String
  productId        String
  unitPrice        Float // Legacy compatibility column; retire after the decimal cutover.
  unitPriceDecimal Decimal? // DECIMAL(19,4) in the migration.
  currencyCode     String? // Supported contracted-rate currency (currently USD); nullable during rollout.
  // Volume tiers, e.g. [{"minQty": 100, "unitPrice": 4.5}, {"minQty": 500, "unitPrice": 3.75}]
  tiers            Json?
  effectiveDate    DateTime @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([customerId, productId])
}

// If an order contains every product in the combo, those lines are discounted
// by percentOff. Scoped to one customer, or global when customerId is null.
model ComboDiscount {
  id                String   @id @default(cuid())
  tenantId          String?
  resourceVersion   Int?
  customerId        String?
  name              String
  percentOff        Float // Legacy compatibility column; retire after the decimal cutover.
  percentOffDecimal Decimal? // DECIMAL(7,4) in the migration.

  customer Customer? @relation(fields: [customerId], references: [id])
  products Product[]
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String?
  resourceVersion Int?
  reference       String? // sales order number, e.g. SO-0042
  customerId      String // immutable after any order item captures pricing
  orderDate       DateTime    @default(now())
  status          OrderStatus @default(OPEN)
  shipTo          String? // receiving party / delivery address
  notes           String?
  currencyCode    String? // Supported order-pricing currency; immutable after capture and nullable only during rollout.

  customer Customer       @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  invoice  Invoice?
  comments OrderComment[]
  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  author    String
  body      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  rateId    String // legacy provenance only; immutable once pricing is captured
  quantity  Float // Legacy compatibility column; retire after the decimal cutover.
  unitPrice Float // Legacy compatibility column; retire after the decimal cutover.

  // Materialized at order time so catalog/rate edits cannot rewrite history.
  // Existing rows are populated later by the bounded backfill in the migration runbook.
  productSkuSnapshot        String?
  productNameSnapshot       String?
  productUnitSnapshot       String?
  quantityDecimal           Decimal? // DECIMAL(19,6): supports fractional metered usage.
  baseUnitPriceDecimal      Decimal? // DECIMAL(19,4): pre-tier/discount contracted rate.
  effectiveUnitPriceDecimal Decimal? // DECIMAL(19,4): final billed unit price.
  amountDecimal             Decimal? // DECIMAL(19,4): authoritative rounded line amount.
  pricingSnapshot           Json? // Tier/discount inputs; monetary JSON values must be decimal strings.
  pricingCapturedAt         DateTime?
  snapshotVersion           Int?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  rate    Rate    @relation(fields: [rateId], references: [id])
}

model Invoice {
  id                     String        @id @default(cuid())
  tenantId               String?
  resourceVersion        Int?
  number                 String        @unique
  customerId             String
  orderId                String        @unique
  status                 InvoiceStatus @default(DRAFT)
  issueDate              DateTime      @default(now())
  dueDate                DateTime
  total                  Float         @default(0) // Legacy compatibility column.
  amountPaid             Float         @default(0) // Legacy compatibility column.
  totalDecimal           Decimal? // DECIMAL(19,4) in the migration.
  amountPaidDecimal      Decimal? // DECIMAL(19,4) in the migration.
  customerNameSnapshot   String?
  customerEmailSnapshot  String?
  billingAddressSnapshot String?
  postedAt               DateTime?
  // An explicit UTC-calendar accounting date, independent of an instant's
  // display timezone. Nullable during the staged backfill rollout.
  accountingDate         String?
  currencyCode           String? // Supported invoice currency (currently USD); immutable once finalized.

  customer      Customer             @relation(fields: [customerId], references: [id])
  order         Order                @relation(fields: [orderId], references: [id])
  lines         InvoiceLine[]
  applications  PaymentApplication[]
  transmissions Transmission[]
  tenant        Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

// This table has exactly one permitted row (id = 1). Its nullable close date
// means no accounting period has been closed yet; the date is inclusive.
model AccountingPeriodControl {
  id                Int      @id @default(1)
  closedThroughDate String?
  updatedAt         DateTime @updatedAt
}

model BackfillCheckpoint {
  jobName     String    @id
  lastId      String?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// Durable request-replay state. State is constrained by the additive migration;
// the runtime schema below is intentionally the source of its typed boundary.
model IdempotencyRecord {
  id                  String                 @id @default(cuid())
  tenantId            String?
  clientScope         String
  method              IdempotencyHttpMethod
  route               String
  idempotencyKey      String
  requestFingerprint  String
  state               IdempotencyRecordState @default(IN_PROGRESS)
  responseStatus      Int?
  responseContentType String?
  responseBodyBase64  String?
  responseEtag        String?
  createdAt           DateTime               @default(now())
  completedAt         DateTime?
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([clientScope, method, route, idempotencyKey])
  @@index([createdAt])
  @@index([tenantId])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float // Legacy compatibility column.
  unitPrice   Float // Legacy compatibility column.
  amount      Float // Legacy compatibility column.

  productSkuSnapshot  String?
  productUnitSnapshot String?
  quantityDecimal     Decimal? // DECIMAL(19,6) in the migration.
  unitPriceDecimal    Decimal? // DECIMAL(19,4) in the migration.
  amountDecimal       Decimal? // DECIMAL(19,4) in the migration.

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// A payment received from a customer. Recording it is separate from applying it;
// one payment can be applied across many invoices.
model Payment {
  id            String   @id @default(cuid())
  tenantId      String?
  customerId    String // immutable receipt party
  amount        Float // Legacy compatibility column; immutable receipt amount.
  amountDecimal Decimal? // DECIMAL(19,4); a legacy null may be backfilled once.
  currencyCode  String? // Supported receipt currency; a legacy null may be backfilled once.
  receivedAt    DateTime @default(now()) // immutable receipt timestamp
  reference     String? // immutable receipt reference

  customer     Customer             @relation(fields: [customerId], references: [id])
  applications PaymentApplication[]
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model PaymentApplication {
  id            String   @id @default(cuid())
  paymentId     String
  invoiceId     String
  amount        Float // Legacy compatibility column; immutable ledger fact.
  amountDecimal Decimal? // DECIMAL(19,4); append-only except a null backfill.
  appliedAt     DateTime @default(now())

  payment   Payment                      @relation(fields: [paymentId], references: [id])
  invoice   Invoice                      @relation(fields: [invoiceId], references: [id])
  reversals PaymentApplicationReversal[]
}

// A positive, append-only compensating entry against an immutable application.
// Reversals never rewrite or delete the original ledger fact.
model PaymentApplicationReversal {
  id                   String   @id @default(cuid())
  paymentApplicationId String
  amountDecimal        Decimal // DECIMAL(19,4); exact reversal amount, always positive.
  reason               String
  accountingDate       String // Explicit UTC-calendar YYYY-MM-DD accounting date.
  actor                String // Server-derived system principal; never accepted from callers.
  createdAt            DateTime @default(now())

  paymentApplication PaymentApplication @relation(fields: [paymentApplicationId], references: [id], onDelete: Restrict)

  @@index([paymentApplicationId])
  @@index([accountingDate])
}

model Transmission {
  id            String             @id @default(cuid())
  invoiceId     String
  method        TransmissionMethod
  status        TransmissionStatus
  externalJobId String?
  detail        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
