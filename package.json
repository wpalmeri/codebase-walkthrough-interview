{
  "name": "meridian-billing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "client",
    "packages/*"
  ],
  "description": "Meridian — billing system for invoices and accounts receivable",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "client": "bun run --cwd client dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "test": "bun test",
    "lint": "oxlint .",
    "typecheck": "bun run typecheck:server && bun run --cwd client typecheck",
    "typecheck:server": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "setup": "bun install --frozen-lockfile && prisma db push && bun run db:seed"
  },
  "dependencies": {
    "@meridian/contracts": "workspace:*",
    "@prisma/client": "^6.5.0",
    "express": "^4.21.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
