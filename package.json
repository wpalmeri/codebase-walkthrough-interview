{
  "name": "midmarket-ehr-architecture-exercise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A realistic EHR platform repository for an engineering-lead architecture exercise",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "npm run db:generate && tsx scripts/wait-for-db.ts && npm run db:push && npm run db:seed",
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/integration",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run db:seed",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm test",
    "package:candidate": "bash scripts/package-candidate.sh"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.6",
    "@prisma/client": "6.19.3",
    "fastify": "5.10.0",
    "fastify-plugin": "5.1.0",
    "pino": "9.9.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
